{
  "name": "contact-capture-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "migrate:local": "wrangler d1 migrations apply contact-capture-prod --local",
    "migrate:prod": "wrangler d1 migrations apply contact-capture-prod --remote",
    "migrate:dev": "wrangler d1 migrations apply contact-capture-dev --remote --env dev",
    "invite": "node scripts/invite.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.40.0"
  }
}
